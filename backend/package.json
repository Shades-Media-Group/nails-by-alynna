{
  "name": "nails-by-alynna-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nails by Alynna API \u2014 Hono on Node.js (local) and Cloudflare Workers (production), MongoDB",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/cli.ts",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy",
    "deploy:verify": "tsx scripts/verify-deploy.ts",
    "check-env": "tsx scripts/check-env.ts",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node dist/node/app.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
