# ─────────────────────────────────────────────────────────────────────────────
# Nails by Alynna API: PRODUCTION on host.md (Plesk → Node.js), behind the Cloudflare Worker.
# Copy to `.env.production` (git-ignored) and fill in every <…>.
# `yarn deploy` checks this file, uploads it to the app root on host.md as `.env` (never into
# public/) and restarts the app. Variables set in Plesk → Node.js → "Custom environment
# variables" win over the file, if you prefer to keep secrets in the panel.
# Seed the first administrator from your machine:  ENV_FILE=.env.production yarn seed
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
# The public HTTPS address people open (the Cloudflare Worker / custom domain), NOT the
# host.md address. Cookies, emails and the Google redirect URI are built from it.
APP_URL=https://<your-domain>
ALLOWED_ORIGINS=
# Passenger (Plesk) assigns the port itself; leave empty.
PORT=
TRUST_PROXY=false
# Required: only the Worker may reach the API. Same value as the Worker secret:
#   cd frontend && npx wrangler secret put PROXY_SECRET   (yarn deploy does this for you)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_SECRET=

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers. Allow host.md's outgoing IP in Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=nails-by-alynna
MONGODB_DB=nails_by_alynna
MONGODB_MAX_POOL_SIZE=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# 48 random bytes, different from development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_MIN=15
REMEMBER_ME_DAYS=365
SESSION_TTL_HOURS=12
PASSWORD_HASH_COST=standard
RATE_LIMITS=on
# Shared read-only demo accounts: off (default) | on | roles, e.g. client or client,admin.
# "client" lets anyone open the client demo with demo / demo (seed it: yarn seed --demo-users).
DEMO_LOGIN=client

# ── Google sign-in and sign-up ───────────────────────────────────────────────
# Same Web client as development. In Google Cloud Console add:
#   Authorized JavaScript origins: https://<your-domain>
#   Authorized redirect URIs:      https://<your-domain>/api/auth/google/callback
# Then Google Auth Platform → Audience → "Publish app" (Testing = test users only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email via Resend (password reset) ────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Nails by Alynna <no-reply@<your-domain>>

# ── First administrator (used only by `yarn seed`, never by the running app) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Alina
SEED_ADMIN_SURNAME=
SEED_DEMO=false
SEED_DEMO_PASSWORD=
