# ─────────────────────────────────────────────────────────────────────────────
# Nails by Alynna API: PRODUCTION on host.md (Plesk → Node.js), behind the Cloudflare Worker.
# Copy to `.env.production` (git-ignored) and fill in every <…>.
# `yarn deploy` checks this file, uploads it to the app root on host.md as `.env` (never into
# public/) and restarts the app. Variables set in Plesk → Node.js → "Custom environment
# variables" win over the file, if you prefer to keep secrets in the panel.
# Seed the first administrator on the server: Plesk → Node.js → Run Node.js commands →
#   npm run seed          (add `-- --demo-users` for the read-only demo accounts)
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
# The public HTTPS address people open (the Cloudflare Worker / custom domain), NOT the
# host.md address. Cookies, emails and the Google redirect URI are built from it.
APP_URL=https://<your-domain>
ALLOWED_ORIGINS=
# Passenger (Plesk) assigns the port itself; leave empty.
PORT=
TRUST_PROXY=false
# Required: only the Worker may reach the API. Same value as the Worker secret:
#   cd frontend && npx wrangler secret put PROXY_SECRET   (yarn deploy does this for you)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_SECRET=

# ── PostgreSQL (host.md) ─────────────────────────────────────────────────────
# Plesk → Databases: the PostgreSQL 10 database and its user. Host = the server's public IP, not
# localhost: host.md's PostgreSQL allows only "ident" (OS user) logins over loopback (error 28000
# "Ident authentication failed"); its public address takes the password. It has no TLS, so keep
# the password on the server. The API creates its tables and indexes on start; seed it there:
# Plesk → Node.js → Run Node.js commands → npm run seed -- --demo-users
DATABASE_URL=postgres://<user>:<password>@<server IP>:5432/<database>
DATABASE_POOL_SIZE=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# 48 random bytes, different from development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_MIN=15
REMEMBER_ME_DAYS=365
SESSION_TTL_HOURS=12
PASSWORD_HASH_COST=standard
RATE_LIMITS=on
# Shared read-only demo accounts: off (default) | on | roles, e.g. client or client,admin.
# "client" lets anyone open the client demo with demo / demo (seed it: yarn seed --demo-users).
DEMO_LOGIN=client

# ── Google sign-in and sign-up ───────────────────────────────────────────────
# Same Web client as development. In Google Cloud Console add:
#   Authorized JavaScript origins: https://<your-domain>
#   Authorized redirect URIs:      https://<your-domain>/api/auth/google/callback
# Then Google Auth Platform → Audience → "Publish app" (Testing = test users only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email: sign-up codes, password resets, visit reminders, booking updates ──
# SMTP (preferred), e.g. the studio's Gmail: smtp.gmail.com, port 465, the Gmail address and a
# Google App password (myaccount.google.com/apppasswords, needs 2-Step Verification), never the
# account password. About 500 emails a day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# EmailJS (used when SMTP is not set; wins over Resend). Free plan: 200 emails a month. The dashboard setup
# (template with Subject {{subject}}, To Email {{to_email}}, Reply To {{reply_to}} and the body
# {{{html}}} in code mode; Account → Security → "Allow EmailJS API for non-browser
# applications" ON, otherwise EmailJS answers 403) is described step by step in .env.template.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Account → Security → Private Key (then turn on "Use Private Key").
EMAILJS_PRIVATE_KEY=
# Alternative provider, used only when neither SMTP nor EmailJS is configured.
RESEND_API_KEY=
# Sender name and address for SMTP and Resend; empty with SMTP = SMTP_USER.
MAIL_FROM=Nails by Alynna <no-reply@<your-domain>>

# ── Web Push (reminders on the phone) ────────────────────────────────────────
# A pair of its own for production, generated once:  npx web-push generate-vapid-keys
# Never change it casually: every phone would have to switch notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@your-domain.md or https://… ; empty = APP_URL.
VAPID_SUBJECT=

# ── Reminders ────────────────────────────────────────────────────────────────
# Checked by the API every N seconds, and by the Cloudflare Worker's cron every 5 minutes
# (POST /api/internal/tick, which also wakes an app Plesk put to sleep).
NOTIFICATIONS_INTERVAL_SEC=60
# Empty = the Worker authenticates the cron with PROXY_SECRET (nothing else to set up). If you
# set it, also set the same value on the Worker: cd frontend && npx wrangler secret put CRON_SECRET
CRON_SECRET=

# ── First administrator (used only by `yarn seed`, never by the running app) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Alina
SEED_ADMIN_SURNAME=
SEED_DEMO=false
SEED_DEMO_PASSWORD=
