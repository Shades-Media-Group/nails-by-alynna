# ─────────────────────────────────────────────────────────────────────────────
# Nails by Alynna API — local development with Node.js (`yarn dev`).
# Copy to `.env` and fill in. Never commit `.env` (it is git-ignored).
# Production (host.md) uses `.env.production`: see `.env.production.template`.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
# Where the app runs (Vite dev server). Used for origin checks, links in emails, OAuth.
APP_URL=http://localhost:5180
# Extra origins allowed to send state-changing requests (comma-separated, optional).
ALLOWED_ORIGINS=
PORT=8787
# Only when running behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false
# Production on host.md: the same random secret as the Cloudflare Worker's PROXY_SECRET.
# When set, requests without it get 404, so only the app's /api proxy can reach the API.
PROXY_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Local: `yarn db:up` (Docker, postgres:10 like production on host.md). The API creates its
# tables and indexes on start. Pool size: empty = 10.
DATABASE_URL=postgres://nba:nba@127.0.0.1:5432/nails_by_alynna
DATABASE_POOL_SIZE=

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# During a key rotation, put the old secret here so existing sessions keep working.
JWT_SECRET_PREVIOUS=
# Seals what masters' connected calendars need (Google refresh tokens, Apple app-specific
# passwords; AES-256-GCM). Optional: empty = derived from JWT_SECRET. Set it (32+ random
# characters, generated like JWT_SECRET) so that rotating JWT_SECRET keeps calendars connected;
# changing it later asks every master to connect their calendar again.
CALENDAR_SYNC_KEY=
ACCESS_TOKEN_TTL_MIN=15
# "Remember me" keeps users signed in (sliding) for this many days.
REMEMBER_ME_DAYS=365
# Without "remember me": session length in hours.
SESSION_TTL_HOURS=12
# standard | fast  (fast is for tests only, rejected in production)
PASSWORD_HASH_COST=standard
# on | off (off is for tests only, rejected in production)
RATE_LIMITS=on
# Shared read-only demo accounts (seeded with `yarn seed --demo-users`). Default: off, which
# hides the demo buttons AND refuses demo sign-ins and existing demo sessions.
#   on = every role · or a list: client | client,admin | client,admin,administrator
# With "client" enabled, anyone can open the client demo by logging in with demo / demo.
DEMO_LOGIN=client

# ── Google sign-in and sign-up (optional) ────────────────────────────────────
# One button does both: the first Google sign-in creates a client account.
# Google Cloud Console → Google Auth Platform → Clients → your "Web application" client:
#   Authorized JavaScript origins: http://localhost:5180   and   https://<your-domain>
#   Authorized redirect URIs:      http://localhost:5180/api/auth/google/callback
#                                  https://<your-domain>/api/auth/google/callback
# The redirect URI is always <APP_URL>/api/auth/google/callback. Both empty = no Google button.
# Before launch: Google Auth Platform → Audience → "Publish app". While the app is in
# "Testing", only the listed test users can sign in. The app asks only for openid, email and
# profile (non-sensitive), so publishing needs no Google review.
# The same client connects masters' Google Calendars (My schedule → Instant sync), through the
# same redirect URI. That asks for https://www.googleapis.com/auth/calendar.app.created (only
# calendars the app makes itself); add it under Google Auth Platform → Data Access. It is a
# sensitive scope: until Google verifies the app, masters see "Google hasn't verified this app"
# and continue with Advanced (at most 100 people). In "Testing", Google ends access after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email: sign-up codes, password resets, visit reminders, booking updates ──
# SMTP is used when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are set, else EmailJS when its three
# ids are set, else Resend. With none, development prints every email (codes included) to this
# console; production sends nothing.
#
# SMTP with the studio's Gmail: about 500 emails a day. SMTP_PASSWORD is a Google App password,
# not the account password: turn on 2-Step Verification, then myaccount.google.com/apppasswords
# → create one → paste the 16 letters (the spaces Google shows don't matter).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
#
# EmailJS (https://dashboard.emailjs.com). Free plan: 200 emails a month. One-time setup:
#  1. Email Services → Add New Service → connect the studio's mailbox → copy its Service ID.
#  2. Email Templates → Create New Template, then fill in exactly:
#       Subject:   {{subject}}
#       To Email:  {{to_email}}
#       Reply To:  {{reply_to}}
#       From Name: Nails by Alynna
#     Content: switch the editor to code (HTML) mode and replace everything with
#       {{{html}}}
#     Three braces = the finished HTML the app sends; two would print the tags as text.
#     Save, and copy the Template ID.
#  3. Account → General → copy the Public Key.
#  4. Account → Security: turn ON "Allow EmailJS API for non-browser applications" (without it
#     EmailJS answers 403 to the server), create a Private Key for EMAILJS_PRIVATE_KEY, and
#     turn on "Use Private Key" so nobody else can send with your public key.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Alternative provider, used only when neither SMTP nor EmailJS is configured.
RESEND_API_KEY=
# Sender name and address for SMTP and Resend; empty with SMTP = SMTP_USER.
MAIL_FROM=Nails by Alynna <no-reply@your-domain.md>

# ── Web Push: reminders and booking updates on the phone ─────────────────────
# One key pair per environment, generated once (keep the private key secret):
#   npx web-push generate-vapid-keys
# A new pair later means every phone has to switch notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto:you@your-domain.md or an https:// address.
# Empty = APP_URL, which only works when APP_URL is https:// (so set it in development).
VAPID_SUBJECT=

# ── Loyalty card in Apple Wallet and Google Wallet (optional) ────────────────
# Each Wallet switches on when all of its values are set; until then the app says "coming
# soon". Values are one line: a PEM with "\n" for its line breaks, or the file in base64:
#   macOS: base64 -i file.pem | tr -d '\n'        Linux: base64 -w0 file.pem
# `yarn check-env <file>` says which Wallets are on and what is missing.
#
# Apple Wallet (needs the paid Apple Developer Program, developer.apple.com/programs):
#  1. Certificates, Identifiers & Profiles → Identifiers → + → Pass Type IDs → description
#     "Nails by Alynna loyalty card", identifier e.g. pass.md.nailsbyalynna.loyalty → Register.
#  2. Make a key and a certificate request (any computer with openssl):
#       openssl req -new -newkey rsa:2048 -nodes -keyout signerKey.pem -out pass.csr -subj "/CN=Nails by Alynna"
#     Open the Pass Type ID → Create Certificate → upload pass.csr → Download (pass.cer), then:
#       openssl x509 -inform der -in pass.cer -out signerCert.pem
#     (Made the request in Keychain Access instead? Export the certificate from "My
#     Certificates" as cert.p12, then: openssl pkcs12 -in cert.p12 -clcerts -nokeys -out signerCert.pem
#     and openssl pkcs12 -in cert.p12 -nocerts -out signerKey.pem (OpenSSL 3 may need -legacy);
#     the PEM pass phrase the second one asks for goes in APPLE_WALLET_SIGNER_KEY_PASSPHRASE.)
#  3. Download "Worldwide Developer Relations - G4" from apple.com/certificateauthority
#     (AppleWWDRCAG4.cer); its base64 goes in APPLE_WALLET_WWDR_CERT as it is.
#  4. The Team ID: developer.apple.com/account → Membership details (10 characters).
# The certificate lasts about a year: renew it the same way and replace the two values.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT=
#
# Google Wallet (free):
#  1. pay.google.com/business/console → sign in with the studio's Google account → Google
#     Wallet API → create the issuer account; the Issuer ID (a long number) is shown there.
#  2. console.cloud.google.com → the project (the one for Google sign-in will do) → APIs &
#     Services → Library → "Google Wallet API" → Enable.
#  3. IAM & Admin → Service Accounts → Create service account (e.g. "wallet"), no roles → open it
#     → Keys → Add key → Create new key → JSON. From that file: client_email and private_key
#     (paste private_key as it is, "\n" included, between double quotes).
#  4. Back in the Pay & Wallet Console → Users → Invite a user → the service account's email,
#     access level "Developer".
#  5. New issuers are in demo mode: cards say [TEST ONLY] and only the console's users and test
#     accounts can save them. Google Wallet API → "Get publishing access" to open it to everyone.
# The card's logo comes from <APP_URL>/wallet/logo.png, so Google must be able to reach APP_URL.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# ── Reminders ────────────────────────────────────────────────────────────────
# The API looks for due reminders every N seconds (0 = never; then only the cron below).
NOTIFICATIONS_INTERVAL_SEC=60
# POST /api/internal/tick with the header "x-nba-cron-key: <secret>" runs the same check for an
# external cron (the Cloudflare Worker does it every 5 minutes). Empty = PROXY_SECRET is used;
# both empty = the endpoint is off. At least 24 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Seeding (`yarn seed`) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Alina
SEED_ADMIN_SURNAME=Admin
# SEED_DEMO=true (= yarn seed --demo): read-only demo accounts + sample clients/appointments
# (sample data is refused when APP_ENV=production; use `yarn seed --demo-users` there).
# Demo accounts: client.demo@example.com, admin.demo@example.com, owner.demo@example.com
SEED_DEMO=false
SEED_DEMO_PASSWORD=nails-demo-2026
