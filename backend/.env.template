# ─────────────────────────────────────────────────────────────────────────────
# Nails by Alynna API — local development with Node.js (`yarn dev`).
# Copy to `.env` and fill in. Never commit `.env` (it is git-ignored).
# Production (host.md) uses `.env.production`: see `.env.production.template`.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
# Where the app runs (Vite dev server). Used for origin checks, links in emails, OAuth.
APP_URL=http://localhost:5180
# Extra origins allowed to send state-changing requests (comma-separated, optional).
ALLOWED_ORIGINS=
PORT=8787
# Only when running behind a reverse proxy you control (reads X-Forwarded-For).
TRUST_PROXY=false
# Production on host.md: the same random secret as the Cloudflare Worker's PROXY_SECRET.
# When set, requests without it get 404, so only the app's /api proxy can reach the API.
PROXY_SECRET=

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local: `yarn db:up` (Docker) or Homebrew mongod. Production: MongoDB Atlas SRV URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nails_by_alynna
MONGODB_MAX_POOL_SIZE=

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# During a key rotation, put the old secret here so existing sessions keep working.
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_MIN=15
# "Remember me" keeps users signed in (sliding) for this many days.
REMEMBER_ME_DAYS=365
# Without "remember me": session length in hours.
SESSION_TTL_HOURS=12
# standard | fast  (fast is for tests only, rejected in production)
PASSWORD_HASH_COST=standard
# on | off (off is for tests only, rejected in production)
RATE_LIMITS=on
# Shared read-only demo accounts (seeded with `yarn seed --demo-users`). Default: off, which
# hides the demo buttons AND refuses demo sign-ins and existing demo sessions.
#   on = every role · or a list: client | client,admin | client,admin,administrator
DEMO_LOGIN=off

# ── Google sign-in and sign-up (optional) ────────────────────────────────────
# One button does both: the first Google sign-in creates a client account.
# Google Cloud Console → Google Auth Platform → Clients → your "Web application" client:
#   Authorized JavaScript origins: http://localhost:5180   and   https://<your-domain>
#   Authorized redirect URIs:      http://localhost:5180/api/auth/google/callback
#                                  https://<your-domain>/api/auth/google/callback
# The redirect URI is always <APP_URL>/api/auth/google/callback. Both empty = no Google button.
# Before launch: Google Auth Platform → Audience → "Publish app". While the app is in
# "Testing", only the listed test users can sign in. The app asks only for openid, email and
# profile (non-sensitive), so publishing needs no Google review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email via Resend (optional; used for password reset) ─────────────────────
RESEND_API_KEY=
MAIL_FROM=Nails by Alynna <no-reply@your-domain.md>

# ── Seeding (`yarn seed`) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Alina
SEED_ADMIN_SURNAME=Admin
# SEED_DEMO=true (= yarn seed --demo): read-only demo accounts + sample clients/appointments
# (sample data is refused when APP_ENV=production; use `yarn seed --demo-users` there).
# Demo accounts: client.demo@example.com, admin.demo@example.com, owner.demo@example.com
SEED_DEMO=false
SEED_DEMO_PASSWORD=nails-demo-2026
