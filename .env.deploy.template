# ─────────────────────────────────────────────────────────────────────────────
# Deploy credentials for `yarn deploy` (scripts/deploy.mjs). Copy to `.env.deploy`
# (git-ignored) and fill in. Nothing here is shipped to the app or the API.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudflare (the app: static PWA + /api proxy Worker) ─────────────────────
# dash.cloudflare.com → My Profile → API Tokens → Create Token → "Edit Cloudflare Workers".
CLOUDFLARE_API_TOKEN=
# Workers & Pages → Overview → Account ID (right column).
CLOUDFLARE_ACCOUNT_ID=

# ── host.md (the API: Plesk → Node.js application) ───────────────────────────
# Public https address of the API app on host.md (becomes the Worker's API_ORIGIN).
API_ORIGIN=
# FTPS account from Plesk → Websites & Domains → FTP Access.
HOSTMD_FTP_HOST=
HOSTMD_FTP_USER=
HOSTMD_FTP_PASSWORD=
# The Node.js application root on the server (where app.js and .env live, NOT public/).
HOSTMD_APP_DIR=/api
