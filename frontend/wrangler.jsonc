{
  // Nails by Alynna — the app (React PWA) on Cloudflare Workers Static Assets.
  // /api/* is proxied by worker/index.ts to the backend, so clients never see its address.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nails-by-alynna",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "vars": {
    // Backend on host.md (Plesk Node.js app): the https:// hostname of that app, one you control,
    // e.g. "https://api.your-domain.md". Empty = the app loads but /api answers 503
    // API_NOT_CONFIGURED (never point this at a domain you do not own: logins pass through it).
    // Or leave it empty and add the "services" binding below to run the API on Cloudflare.
    "API_ORIGIN": ""
  }
  // Secret shared with the backend (PROXY_SECRET): wrangler secret put PROXY_SECRET
  //
  // Alternative backend on Cloudflare Workers (backend/wrangler.jsonc):
  // "services": [{ "binding": "API", "service": "nails-by-alynna-api" }]
  //
  // Custom domain:
  // "routes": [{ "pattern": "app.your-domain.md", "custom_domain": true }]
}
